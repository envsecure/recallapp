{
  "name": "recall",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Fully-offline semantic search over a folder of images. See GOAL.md.",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixtures": "node test/fixtures/generate.mjs",
    "docs:audit": "node scripts/docs-audit.mjs",
    "docs:audit:write": "node scripts/docs-audit.mjs --write",
    "docs:check": "npm run docs:audit",
    "index": "tsx src/index/cli.ts",
    "serve": "tsx src/index/dev.ts",
    "benchmark": "tsx scripts/benchmark.mjs"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^24.19.2",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "express": "^4.22.3"
  }
}
