# Dependencies are installed on demand, on a machine that can afford them.
#
# The dev box (2.7 GB RAM, 3.3 GB free disk, no GPU) cannot run models, so
# nothing here may download weights at install time or at import time.
# See AGENT.md and GOAL.md C2.

node_modules/
dist/
build/
coverage/

# Model weights — never committed, several hundred MB.
# Fetched by scripts/fetch-models.sh into $RECALL_DATA_DIR/models (default
# ~/.localrecall/models), which is outside the repo. Listed here as a backstop.
models/
*.onnx
*.onnx_data
*.gguf

# Generated fixtures — regenerate with `npm run fixtures`.
test/fixtures/generated/
tmp/
scratch/

# Local index databases and caches.
data/
*.db
*.db-journal
*.db-wal
*.db-shm
thumbs/

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Logs
*.log
npm-debug.log*

# Python bytecode from scripts/*.py
__pycache__/
*.py[cod]

# Downloaded test images
sample-images/
# web build
web/node_modules/
web/dist/
