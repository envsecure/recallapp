models/
*.onnx
*.onnx_data
*.gguf

# Generated fixtures — regenerate with `npm run fixtures`.
test/fixtures/generated/
tmp/
scratch/

# Local index databases and caches.
data/
*.db
*.db-journal
*.db-wal
*.db-shm
thumbs/

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Logs
*.log
npm-debug.log*
# web build
web/node_modules/
web/dist/
